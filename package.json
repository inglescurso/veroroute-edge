{
  "name": "veroroute-edge",
  "version": "1.0.0",
  "description": "VeroRoute Edge: Lightweight, Aerodynamic Serverless AI Gateway & Smart Router for Cloudflare Workers (Inspired by OmniRoute & VeroRoute)",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsc --noEmit && npm run check:dashboard",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:dashboard": "tsx scripts/check-dashboard.ts"
  },
  "keywords": [
    "veroroute",
    "veroroute-edge",
    "omniroute",
    "cloudflare-workers",
    "ai-gateway",
    "llm-router",
    "openai",
    "anthropic",
    "antigravity",
    "searxng",
    "fallback"
  ],
  "author": "Samuel Santos (samucamg)",
  "license": "MIT",
  "dependencies": {
    "hono": "^4.7.2",
    "puppeteer": "^25.11.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "@esbuild/linux-x64": "^0.28.2",
    "@types/node": "^26.6.1",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.132.0"
  }
}
